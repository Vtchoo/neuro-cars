{
  "name": "smart-race-3",
  "version": "1.0.0",
  "description": "Neural Network Car Simulation with TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:3d": "vite --open /3d",
    "dev:cars": "vite --open /3d/debug",
    "build": "vite build",
    "tsc-build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:core": "node tests/core.cjs && node tests/track-performance.cjs && node tests/maps.cjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/p5": "^1.7.6",
    "@types/three": "^0.187.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "mapbox-gl": "^3.34.1",
    "p5": "^1.7.0",
    "three": "^0.187.0"
  },
  "keywords": [
    "neural-network",
    "genetic-algorithm",
    "p5js",
    "simulation",
    "typescript"
  ],
  "author": "",
  "license": "ISC"
}
